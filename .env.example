# Copy to .env (ignored by git) to customise the Docker build/run. All values optional.
# PAGESAIL_PORT=8080
# PAGESAIL_REPO_URL=https://github.com/<owner>/<repo>
# PAGESAIL_MAX_PDF_MB=500
# PAGESAIL_MAX_IMAGE_MB=100
# PAGESAIL_MAX_IMAGE_MEGAPIXELS=64
# PAGESAIL_MAX_RENDER_MEGAPIXELS=64
# PAGESAIL_MAX_FILES=200
# PAGESAIL_HISTORY_STEPS=50
